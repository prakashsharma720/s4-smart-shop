document.addEventListener("DOMContentLoaded", function () {

    // ======= Buy Now Button =======
    const buyNowBtn = document.getElementById("buyNowBtn");
    if (buyNowBtn) {
        buyNowBtn.addEventListener("click", function(e) {
            e.preventDefault();
            const authToken = localStorage.getItem("authToken");

            if (!authToken) {
                // Login/signup page par redirect ke sath
                window.location.href = "login.php?redirect=booking.php";
            } else {
                window.location.href = "booking.php";
            }
        });
    }

    // ======= Login Form =======
    const loginForm = document.getElementById("loginForm");
    if (loginForm) {
        loginForm.addEventListener("submit", async function (e) {
            e.preventDefault();
            const email = document.getElementById("email").value.trim();
            const password = document.getElementById("password").value.trim();

            try {
                const response = await fetch("https://laravelapi.modevcloud.com/public/api/login", {
                    method: "POST",
                    headers: {
                        "Accept": "application/json",
                        "Content-Type": "application/json",
                        "Client-ID": "fKyMMobdr5",
                        "Client-Secret": "9Y6ROTNVKd"
                    },
                    body: JSON.stringify({ email, password })
                });

                const data = await response.json();

                if (data.status === 200 && data.access_token) {
                    localStorage.setItem("authToken", data.access_token);
                    localStorage.setItem("user", JSON.stringify(data.user_data));

                    const params = new URLSearchParams(window.location.search);
                    const redirectUrl = params.get("redirect");

                    if (redirectUrl) {
                        window.location.href = redirectUrl; // Buy Now → booking
                    } else {
                        alert("✅ Login Successful!");
                    }
                } else {
                    alert(data.message || "❌ Invalid email or password");
                }

            } catch (error) {
                console.error(error);
                alert("⚠️ Something went wrong. Please try again.");
            }
        });
    }

    // ======= Signup Form =======
    const signupForm = document.getElementById("signupForm");
    if (signupForm) {
        signupForm.addEventListener("submit", async function (e) {
            e.preventDefault();
            const name = document.getElementById("name").value.trim();
            const email = document.getElementById("email_signup").value.trim();
            const password = document.getElementById("password_signup").value.trim();

            try {
                const response = await fetch("https://laravelapi.modevcloud.com/public/api/register", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Client-ID": "fKyMMobdr5",
                        "Client-Secret": "9Y6ROTNVKd"
                    },
                    body: JSON.stringify({ name, email, password })
                });

                const data = await response.json();

                if (response.ok) {
                    // Optional: agar API token return kare
                    if (data.access_token) localStorage.setItem("authToken", data.access_token);
                    localStorage.setItem("user", JSON.stringify(data.user_data || { name }));

                    const params = new URLSearchParams(window.location.search);
                    const redirectUrl = params.get("redirect");

                    if (redirectUrl) {
                        window.location.href = redirectUrl; // Buy Now → booking
                    } else {
                        alert("✅ Signup Successful!");
                    }

                } else {
                    alert(data.message || "❌ Signup failed!");
                }
            } catch (error) {
                console.error(error);
                alert("⚠️ Something went wrong. Please try again.");
            }
        });
    }

});
document.addEventListener("DOMContentLoaded", function() {

    // ====== Variables ======
    const quantityInput = document.getElementById("quantity");
    const itemCount = document.getElementById("itemCount");
    const totalPriceEl = document.getElementById("totalPrice");
    const discountEl = document.getElementById("discount");
    const warrantyRow = document.getElementById("warrantyRow");
    const warrantyPriceEl = document.getElementById("warrantyPrice");
    const finalAmountEl = document.getElementById("finalAmount");
    const savingText = document.getElementById("savingText");

    const basePrice = 1199; // Original product price
    const discount = 700; // Discount amount
    const warrantyPrice = 29;

    let qty = parseInt(quantityInput.value);
    let warrantyAdded = false;

    // ====== Update Prices ======
    function updatePrices() {
        let totalPrice = basePrice * qty;
        totalPriceEl.innerText = `₹${totalPrice}`;
        discountEl.innerText = `-₹${discount * qty}`;

        let warrantyTotal = warrantyAdded ? warrantyPrice : 0;
        if (warrantyAdded) {
            warrantyRow.style.display = "flex";
            warrantyPriceEl.innerText = `₹${warrantyTotal}`;
        } else {
            warrantyRow.style.display = "none";
        }

        let finalAmount = totalPrice - (discount * qty) + warrantyTotal;
        finalAmountEl.innerText = `₹${finalAmount}`;
        itemCount.innerText = qty;
        savingText.innerText = `You will save ₹${discount * qty} on this order`;
    }

    // ====== Quantity Buttons ======
    document.getElementById("increaseQty").addEventListener("click", function() {
        qty++;
        quantityInput.value = qty;
        updatePrices();
    });

    document.getElementById("decreaseQty").addEventListener("click", function() {
        if (qty > 1) {
            qty--;
            quantityInput.value = qty;
            updatePrices();
        }
    });

    // ====== Add Warranty ======
    document.getElementById("addWarranty").addEventListener("click", function() {
        warrantyAdded = !warrantyAdded;
        this.innerText = warrantyAdded ? "Remove Warranty" : "Add Item";
        updatePrices();
    });

    // ====== Remove Item ======
    document.getElementById("removeItem").addEventListener("click", function(e) {
        e.preventDefault();
        // Reset everything
        qty = 0;
        quantityInput.value = qty;
        warrantyAdded = false;
        updatePrices();
        alert("Item removed from cart!");
    });

    // ====== Place Order Button ======
    const placeOrderBtn = document.querySelector(".btn-warning.w-100");
    placeOrderBtn.addEventListener("click", function() {
        const authToken = localStorage.getItem("authToken");

        if (!authToken) {
            // Redirect to login page before booking
            window.location.href = "login.php?redirect=booking.php";
        } else {
            // User logged in, proceed
            window.location.href = "booking.php";
        }
    });

    // Initial update
    updatePrices();

});
